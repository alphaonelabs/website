# Local development only. Use credentials from a separate GitHub OAuth app.
GITHUB_CLIENT_ID="your-local-oauth-app-client-id"
GITHUB_CLIENT_SECRET="your-local-oauth-app-client-secret"
GITHUB_REDIRECT_URI="http://localhost:8787/auth/callback"

# Fallback used only when GITHUB_REDIRECT_URI is missing or empty.
GITHUB_REDIRECT_URI_DEFAULT="http://localhost:8787/auth/callback"

# Required to verify webhook deliveries when testing webhooks locally.
# Replace this placeholder with a random value; never use a production secret.
GITHUB_WEBHOOK_SECRET="replace-with-a-random-local-secret"
