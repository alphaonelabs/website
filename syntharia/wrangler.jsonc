{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Syntharia — Creative AI Studio
  // Cloudflare Python Workers with Workers AI
  "name": "syntharia",
  "main": "src/entry.py",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": [
    "python_workers"
  ],
  // Workers AI binding — accessible as self.env.AI
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
