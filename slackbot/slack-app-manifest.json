{
  "display_information": {
    "name": "Alpha One Labs Bot",
    "description": "Reminds contributors to get a peer review before asking maintainers.",
    "background_color": "#0f0f0f"
  },
  "features": {
    "bot_user": {
      "display_name": "alphaonelabs",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["channels:history", "chat:write", "reactions:write", "incoming-webhook"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://slackbot.alphaonelabs.com/slack/events",
      "bot_events": ["message.channels"]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
