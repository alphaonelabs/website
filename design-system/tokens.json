    "primary": "#D4AF37", "primary-hover": "#F0C658", "primary-on-dark": "#E1B746", "primary-ink": "#7A6418",
    "black": "#000000", "ink": "#101010", "white": "#FFFFFF",
    "gray-50": "#FAFAFA", "gray-100": "#F5F5F5", "gray-200": "#E6E6E6", "gray-300": "#D8D8D8",
    "gray-400": "#A3A3A3", "gray-500": "#737373", "gray-600": "#4A4A4A", "gray-700": "#262626",
    "gray-800": "#1A1A1A", "gray-900": "#0F0F0F"
